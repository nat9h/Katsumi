# Login: "qr" or "pairing"
LOGIN_METHOD=pairing
PAIRING_NUMBER=62xxx
PAIRING_DELAY=3000

# 'sqlite' | 'json'
DB_TYPE=sqlite
DB_PATH=./data/bot.db

# Clone bot DB: 'sqlite' | 'json' (falls back to DB_TYPE if unset)
CLONE_DB_TYPE=sqlite

LOG_LEVEL=silent
PREFIX=!,.,?
OWNER_JID=62xxx
MAX_RECONNECT=10
RECONNECT_DELAY=1000

STORE_CONTACTS=true
STORE_GROUPS=true
STORE_CHATS=false
