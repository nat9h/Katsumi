# Timezone (e.g. Asia/Jakarta, Asia/Makassar, America/New_York)
TZ=Asia/Jakarta

# Login: "qr" or "pairing"
LOGIN_METHOD=pairing
PAIRING_NUMBER=62xxx
PAIRING_DELAY=3000

# 'sqlite' | 'json'
DB_TYPE=sqlite
DB_PATH=./data/bot.db

# Clone bot DB: 'sqlite' | 'json' (falls back to DB_TYPE if unset)
CLONE_DB_TYPE=sqlite

LOG_LEVEL=silent
PREFIX=!,.,?
OWNER_JID=62xxx
MAX_RECONNECT=10
RECONNECT_DELAY=1000

STORE_CONTACTS=true
STORE_GROUPS=true
STORE_CHATS=false

# Set 'true' if u want see logs
MSG_LOGS=false

GROQ_API_KEY=

# Instagram cookies (required for IG downloader)
# Get from browser: Login to IG > DevTools > Application > Cookies
# sessionid = required (for posts, reels, story photos)
# ig_did, mid, ds_user_id = required for story videos
IG_SESSION_ID=
IG_DS_USER_ID=
IG_MID=
IG_DID=

# Facebook cookies (optional)
# Get from browser: Login to FB > DevTools > Application > Cookies > facebook.com
# c_user = numeric user ID, xs = session token
FB_C_USER=
FB_XS=

# Twitter/X credentials (required for Twitter downloader)
# Get from browser: Login to x.com > DevTools > Application > Cookies
X_AUTH_TOKEN=
X_CT0=

# Bearer: DevTools > Network > any api.x.com request > Authorization header
# EP_TWEET & EP_PROFILE: DevTools > Network > filter "graphql" >
#   URL format: https://x.com/i/api/graphql/{queryId}/{OperationName}
#   EP_TWEET = queryId from TweetDetail request
#   EP_PROFILE = queryId from UserByScreenName request
# These may change when Twitter deploys updates.
X_BEARER=
X_EP_TWEET=
X_EP_PROFILE=

# Morphic.sh credentials (required for AI chat command)
MORPHIC_EMAIL=
MORPHIC_PASSWORD=